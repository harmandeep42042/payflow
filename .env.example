# ===========================
# Database
# ===========================

DATABASE_URL="postgresql://payflow:payflow_password@localhost:5433/payflow_db?schema=public"

# ===========================
# JWT
# ===========================

JWT_SECRET="replace_with_a_secure_access_secret"

JWT_REFRESH_SECRET="replace_with_a_secure_refresh_secret"

JWT_EXPIRES_IN="15m"

JWT_REFRESH_EXPIRES_IN="7d"

# ===========================
# RabbitMQ
# ===========================

RABBITMQ_URL="amqp://payflow:payflow_password@localhost:5672"

RABBITMQ_QUEUE="wallet_events"

PAYMENT_RABBITMQ_QUEUE="payment_events"

# ===========================
# Redis
# ===========================

REDIS_HOST="localhost"

REDIS_PORT=6379

# ===========================
# Services
# ===========================

API_GATEWAY_PORT=4000

AUTH_SERVICE_PORT=4002

WALLET_SERVICE_PORT=4001

NOTIFICATION_SERVICE_PORT=4003

# ===========================
# URLs
# ===========================

AUTH_SERVICE_URL="http://localhost:4002/api"

WALLET_SERVICE_URL="http://localhost:4001/api/v1"

API_GATEWAY_URL="http://localhost:4000/api/v1"
REDIS_URL="redis://localhost:6379"

# Admin bootstrap
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-production

# External payment providers (wallet-service only; never expose these as NEXT_PUBLIC variables)
# Leave PROVIDER unset or set to "none" until a real server-side adapter is installed.
RECHARGE_PROVIDER="none"
RECHARGE_PROVIDER_API_URL="https://provider.example/recharge"
RECHARGE_PROVIDER_KEY="replace-with-secret-manager-reference"

BILL_PROVIDER="none"
BILL_PROVIDER_API_URL="https://provider.example/bills"
BILL_PROVIDER_KEY="replace-with-secret-manager-reference"

AUTOPAY_PROVIDER="none"
AUTOPAY_PROVIDER_API_URL="https://provider.example/autopay"
AUTOPAY_PROVIDER_KEY="replace-with-secret-manager-reference"
