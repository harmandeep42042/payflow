# ===========================
# Database
# ===========================

DATABASE_URL="postgresql://payflow:payflow_password@localhost:5433/payflow_db?schema=public"

# ===========================
# JWT
# ===========================

JWT_SECRET="replace_with_a_secure_access_secret"

JWT_REFRESH_SECRET="replace_with_a_secure_refresh_secret"

JWT_EXPIRES_IN="15m"

JWT_REFRESH_EXPIRES_IN="7d"

# ===========================
# RabbitMQ
# ===========================

RABBITMQ_URL="amqp://payflow:payflow_password@localhost:5672"

RABBITMQ_QUEUE="wallet_events"

# ===========================
# Redis
# ===========================

REDIS_HOST="localhost"

REDIS_PORT=6379

# ===========================
# Services
# ===========================

API_GATEWAY_PORT=4000

AUTH_SERVICE_PORT=4002

WALLET_SERVICE_PORT=4001

NOTIFICATION_SERVICE_PORT=4003

# ===========================
# URLs
# ===========================

AUTH_SERVICE_URL="http://localhost:4002/api"

WALLET_SERVICE_URL="http://localhost:4001/api/v1"

API_GATEWAY_URL="http://localhost:4000/api/v1"