generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  phone        String?    @unique
  vpa          String?    @unique
  firstName    String
  lastName     String?
  passwordHash String?
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  wallets                Wallet[]
  refreshTokens          RefreshToken[]
  notificationPreference NotificationPreference?
  contactsOwned          Contact[]                   @relation("ContactOwner")
  contactsReceived       Contact[]                   @relation("ContactRecipient")
  offerClaims            OfferClaim[]
  moneyRequestsCreated   MoneyRequest[]              @relation("MoneyRequester")
  moneyRequestsToPay     MoneyRequest[]              @relation("MoneyPayer")
  billSplitsCreated      BillSplit[]                 @relation("SplitCreator")
  splitAllocations       SplitAllocation[]
  mandates               Mandate[]
  supportCases           SupportCase[]
  rechargeAttempts       RechargeAttempt[]
  billPaymentAttempts    BillPaymentAttempt[]
  bankAccounts           BankAccount[]
  paymentMethods         PaymentMethod[]
  upiPaymentsSent        UpiPaymentIntent[]          @relation("UpiSender")
  upiPaymentsReceived    UpiPaymentIntent[]          @relation("UpiReceiver")
  paymentAuthProfile     PaymentAuthProfile?
  paymentAuthAttempts    PaymentAuthAttempt[]
  merchantPayments       MerchantPayment[]
  merchantProfile        Merchant?
  paymentTemplates       PaymentTemplate[]
  recurringSchedules     RecurringPaymentSchedule[]
  transactionCategories  TransactionClassification[]
  riskProfile            RiskProfile?
  riskSignals            RiskSignal[]
}

enum RiskStatus {
  CLEAR
  REVIEW_REQUIRED
  RESTRICTED
}

enum RiskSignalType {
  RAPID_TRANSFERS
  DUPLICATE_PATTERN
  HIGH_VALUE_ACTIVITY
  PROVIDER_RISK
}

enum RiskSignalStatus {
  OPEN
  REVIEWED
  DISMISSED
  RESOLVED
}

enum ExternalVerificationStatus {
  NOT_CONFIGURED
  PENDING
  VERIFIED
  FAILED
  LOCKED
}

enum UpiPaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  REVERSED
}

enum UpiPaymentKind {
  PAY
  COLLECT
}

enum PaymentAuthenticationStatus {
  PROVIDER_BLOCKED
  NOT_CONFIGURED
  PENDING
  VERIFIED
  FAILED
  LOCKED
}

enum MerchantOnboardingStatus {
  DRAFT
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  REJECTED
}

enum MerchantPaymentStatus {
  CREATED
  PENDING

  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  REVERSED
  NEEDS_REVIEW
}

enum RefundStatus {
  PROVIDER_NOT_CONFIGURED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PaymentMethodType {
  BANK_ACCOUNT
  CARD_TOKEN
  RUPAY_TOKEN
  UPI_VPA
}

enum PaymentMethodStatus {
  NOT_CONFIGURED
  PENDING
  ACTIVE
  INACTIVE
  REMOVED
  FAILED
}

enum TransactionCategory {
  FOOD
  SHOPPING
  TRAVEL
  BILLS
  RECHARGE
  TRANSFER
  RENT
  ENTERTAINMENT
  OTHER
}

enum RecurringPaymentStatus {
  DRAFT
  PROVIDER_BLOCKED
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
  FAILED
}

enum RecurringPaymentFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

model BankAccount {
  id                  String                     @id @default(uuid())
  userId              String
  bankName            String
  accountHolderName   String
  maskedAccountNumber String
  accountFingerprint  String
  ifsc                String
  status              ExternalVerificationStatus @default(NOT_CONFIGURED)
  isPrimary           Boolean                    @default(false)
  providerReference   String?
  linkedAt            DateTime                   @default(now())
  unlinkedAt          DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  user                User                       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, accountFingerprint])
  @@index([userId, status])
}

model PaymentMethod {
  id               String              @id @default(uuid())
  userId           String
  type             PaymentMethodType
  label            String
  maskedIdentifier String
  providerTokenRef String?
  cardBrand        String?
  expiryMonth      Int?
  expiryYear       Int?
  status           PaymentMethodStatus @default(NOT_CONFIGURED)
  isDefault        Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  removedAt        DateTime?
  user             User                @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([providerTokenRef])
}

model UpiPaymentIntent {
  id                   String                     @id @default(uuid())
  senderUserId         String
  receiverUserId       String?
  senderVpa            String
  receiverVpa          String
  kind                 UpiPaymentKind
  amount               Decimal                    @db.Decimal(18, 2)
  currency             String                     @db.VarChar(3)
  note                 String?
  status               UpiPaymentStatus           @default(CREATED)
  providerState        ExternalVerificationStatus @default(NOT_CONFIGURED)
  providerReference    String?
  transactionReference String                     @unique
  idempotencyKey       String                     @unique
  expiresAt            DateTime
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  completedAt          DateTime?
  sender               User                       @relation("UpiSender", fields: [senderUserId], references: [id], onDelete: Restrict)
  receiver             User?                      @relation("UpiReceiver", fields: [receiverUserId], references: [id], onDelete: Restrict)
  auditEvents          UpiTransactionAudit[]

  @@index([senderUserId, status, createdAt])
  @@index([receiverUserId, status, createdAt])
  @@index([expiresAt, status])
}

model UpiTransactionAudit {
  id           String            @id @default(uuid())
  upiPaymentId String
  fromStatus   UpiPaymentStatus?
  toStatus     UpiPaymentStatus
  actorUserId  String?
  reasonCode   String?
  metadata     Json?
  createdAt    DateTime          @default(now())
  upiPayment   UpiPaymentIntent  @relation(fields: [upiPaymentId], references: [id], onDelete: Cascade)

  @@index([upiPaymentId, createdAt])
}

model PaymentAuthProfile {
  id                  String                      @id @default(uuid())
  userId              String                      @unique
  status              PaymentAuthenticationStatus @default(PROVIDER_BLOCKED)
  failedAttemptCount  Int                         @default(0)
  lockedUntil         DateTime?
  providerReference   String?
  credentialHash      String?
  credentialChangedAt DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  user                User                        @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model PaymentAuthAttempt {
  id          String                      @id @default(uuid())
  userId      String
  operation   String
  status      PaymentAuthenticationStatus
  reasonCode  String?
  attemptedAt DateTime                    @default(now())
  user        User                        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, attemptedAt])
}

model Merchant {
  id               String                     @id @default(uuid())
  ownerUserId      String?                    @unique
  displayName      String
  legalName        String?
  category         String
  merchantVpa      String                     @unique
  qrIdentity       String                     @unique
  onboardingStatus MerchantOnboardingStatus   @default(PENDING_VERIFICATION)
  providerState    ExternalVerificationStatus @default(NOT_CONFIGURED)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  payments         MerchantPayment[]
  owner            User?                      @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@index([onboardingStatus, category])
}

model RiskProfile {
  id           String     @id @default(uuid())
  userId       String     @unique
  status       RiskStatus @default(CLEAR)
  reviewReason String?
  reviewedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model RiskSignal {
  id               String           @id @default(uuid())
  userId           String
  type             RiskSignalType
  status           RiskSignalStatus @default(OPEN)
  severity         String           @default("MEDIUM")
  transferId       String?
  summary          String
  evidence         Json
  detectedAt       DateTime         @default(now())
  reviewedAt       DateTime?
  reviewedByUserId String?
  resolutionNote   String?
  user             User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status, detectedAt])
  @@index([type, status])
}

model MerchantPayment {
  id                   String                     @id @default(uuid())
  userId               String
  merchantId           String
  amount               Decimal                    @db.Decimal(18, 2)
  currency             String                     @db.VarChar(3)
  status               MerchantPaymentStatus      @default(CREATED)
  providerState        ExternalVerificationStatus @default(NOT_CONFIGURED)
  providerReference    String?
  transactionReference String                     @unique
  idempotencyKey       String                     @unique
  receiptNumber        String?                    @unique
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  completedAt          DateTime?
  processingStartedAt  DateTime?
  lastRecoveryAt       DateTime?
  recoveryAttempts     Int                        @default(0)
  failureReason        String?
  user                 User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  merchant             Merchant                   @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  refunds              MerchantRefund[]

  @@index([userId, createdAt])
  @@index([merchantId, status])
}

model MerchantRefund {
  id                String          @id @default(uuid())
  merchantPaymentId String
  amount            Decimal         @db.Decimal(18, 2)
  currency          String          @db.VarChar(3)
  reason            String?
  status            RefundStatus    @default(PROVIDER_NOT_CONFIGURED)
  providerReference String?
  idempotencyKey    String          @unique
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  merchantPayment   MerchantPayment @relation(fields: [merchantPaymentId], references: [id], onDelete: Restrict)

  @@index([merchantPaymentId, status])
}

model TransactionClassification {
  id         String              @id @default(uuid())
  userId     String
  transferId String
  category   TransactionCategory @default(OTHER)
  source     String              @default("USER")
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  user       User                @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, transferId])
  @@index([userId, category])
}

model PaymentTemplate {
  id                String                     @id @default(uuid())
  userId            String
  name              String
  destinationRef    String
  maskedDestination String
  amount            Decimal?                   @db.Decimal(18, 2)
  currency          String                     @db.VarChar(3)
  note              String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  user              User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  schedules         RecurringPaymentSchedule[]

  @@index([userId, updatedAt])
}

model RecurringPaymentSchedule {
  id             String                      @id @default(uuid())
  userId         String
  templateId     String
  frequency      RecurringPaymentFrequency
  startAt        DateTime
  endAt          DateTime?
  nextRunAt      DateTime
  status         RecurringPaymentStatus      @default(PROVIDER_BLOCKED)
  idempotencyKey String                      @unique
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  user           User                        @relation(fields: [userId], references: [id], onDelete: Restrict)
  template       PaymentTemplate             @relation(fields: [templateId], references: [id], onDelete: Restrict)
  executions     RecurringPaymentExecution[]

  @@index([userId, status])
  @@index([status, nextRunAt])
}

model RecurringPaymentExecution {
  id             String                   @id @default(uuid())
  scheduleId     String
  scheduledFor   DateTime
  status         RecurringPaymentStatus   @default(PROVIDER_BLOCKED)
  idempotencyKey String                   @unique
  failureCode    String?
  transferId     String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  schedule       RecurringPaymentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)

  @@index([scheduleId, scheduledFor])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  deviceName String?
  userAgent  String?
  ipAddress  String?
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([lastUsedAt])
}

model Wallet {
  id        String       @id @default(uuid())
  userId    String
  currency  String       @default("INR")
  balance   Decimal      @default(0) @db.Decimal(18, 2)
  version   Int          @default(0)
  status    WalletStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user              User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  ledgerAccount     LedgerAccount?
  outgoingTransfers Transfer[]     @relation("SourceWallet")
  incomingTransfers Transfer[]     @relation("DestinationWallet")
  deposits          Deposit[]
  withdrawals       Withdrawal[]
  moneyRequests     MoneyRequest[]
  billSplits        BillSplit[]

  @@unique([userId, currency])
  @@index([userId])
  @@index([status])
}

model LedgerAccount {
  id        String              @id @default(uuid())
  walletId  String?             @unique
  code      String              @unique
  name      String
  type      LedgerAccountType
  currency  String              @default("INR")
  status    LedgerAccountStatus @default(ACTIVE)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  wallet  Wallet?       @relation(fields: [walletId], references: [id], onDelete: Restrict)
  entries LedgerEntry[]

  @@index([type])
  @@index([currency])
  @@index([status])
}

model Transfer {
  id                  String         @id @default(uuid())
  idempotencyKey      String         @unique
  sourceWalletId      String
  destinationWalletId String
  amount              Decimal        @db.Decimal(18, 2)
  currency            String         @default("INR")
  status              TransferStatus @default(PENDING)
  description         String?
  failureReason       String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  completedAt         DateTime?

  sourceWallet              Wallet           @relation("SourceWallet", fields: [sourceWalletId], references: [id], onDelete: Restrict)
  destinationWallet         Wallet           @relation("DestinationWallet", fields: [destinationWalletId], references: [id], onDelete: Restrict)
  ledgerEntries             LedgerEntry[]
  moneyRequestSettlement    MoneyRequest?    @relation("MoneyRequestSettlement")
  splitAllocationSettlement SplitAllocation? @relation("SplitAllocationSettlement")
  supportCases              SupportCase[]

  @@index([sourceWalletId])
  @@index([destinationWalletId])
  @@index([status])
  @@index([createdAt])
}

model Deposit {
  id             String        @id @default(uuid())
  idempotencyKey String        @unique
  walletId       String
  amount         Decimal       @db.Decimal(18, 2)
  currency       String        @default("INR")
  reference      String
  status         DepositStatus @default(PENDING)
  failureReason  String?
  settlementPaymentId         String?
  settlementProviderPaymentId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  completedAt    DateTime?

  wallet        Wallet        @relation(fields: [walletId], references: [id], onDelete: Restrict)
  ledgerEntries LedgerEntry[]

  @@index([walletId])
  @@index([status])
  @@index([createdAt])
  @@index([settlementPaymentId])
  @@index([settlementProviderPaymentId])
}

model Withdrawal {
  id             String           @id @default(uuid())
  idempotencyKey String           @unique
  walletId       String
  amount         Decimal          @db.Decimal(18, 2)
  currency       String           @default("INR")
  reference      String
  status         WithdrawalStatus @default(PENDING)
  failureReason  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  completedAt    DateTime?

  wallet        Wallet        @relation(fields: [walletId], references: [id], onDelete: Restrict)
  ledgerEntries LedgerEntry[]

  @@index([walletId])
  @@index([status])
  @@index([createdAt])
}

model LedgerEntry {
  id              String          @id @default(uuid())
  transferId      String?
  depositId       String?
  withdrawalId    String?
  ledgerAccountId String
  entryType       LedgerEntryType
  amount          Decimal         @db.Decimal(18, 2)
  currency        String          @default("INR")
  createdAt       DateTime        @default(now())

  transfer      Transfer?     @relation(fields: [transferId], references: [id], onDelete: Restrict)
  deposit       Deposit?      @relation(fields: [depositId], references: [id], onDelete: Restrict)
  withdrawal    Withdrawal?   @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)
  ledgerAccount LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  @@unique([transferId, ledgerAccountId, entryType], map: "LedgerEntry_transfer_leg_unique")
  @@unique([depositId, ledgerAccountId, entryType], map: "LedgerEntry_deposit_leg_unique")
  @@unique([withdrawalId, ledgerAccountId, entryType], map: "LedgerEntry_withdrawal_leg_unique")
  @@index([transferId])
  @@index([depositId])
  @@index([withdrawalId])
  @@index([ledgerAccountId, createdAt])
  @@index([entryType])
}

model OutboxEvent {
  id            String       @id @default(uuid())
  producer      String?
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  createdAt     DateTime     @default(now())
  publishedAt   DateTime?
  lastError     String?
  claimedAt     DateTime?
  claimedBy     String?

  @@index([status, createdAt])
  @@index([producer, status, createdAt])
  @@index([producer, status, claimedAt])
  @@index([aggregateType, aggregateId])
}

model NotificationLog {
  id                String             @id @default(uuid())
  eventId           String?
  dedupeKey         String             @unique
  eventType         String
  recipient         String
  subject           String
  status            NotificationStatus @default(PENDING)
  providerMessageId String?
  errorMessage      String?
  attempts          Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  sentAt            DateTime?

  @@index([status, createdAt])
  @@index([recipient])
  @@index([eventType])
  @@index([eventId])
}

model NotificationPreference {
  id                 String   @id @default(uuid())
  userId             String   @unique
  inAppEnabled       Boolean  @default(true)
  emailEnabled       Boolean  @default(true)
  transfersEnabled   Boolean  @default(true)
  depositsEnabled    Boolean  @default(true)
  withdrawalsEnabled Boolean  @default(true)
  paymentsEnabled    Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  PREVIEW
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  SUSPENDED
}

enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum LedgerAccountType {
  CUSTOMER
  SYSTEM
}

enum LedgerAccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum TransferStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  NEEDS_REVIEW
  REVERSED
}

enum DepositStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum PaymentProvider {
  MOCK
  RAZORPAY
  STRIPE
}

enum PaymentStatus {
  CREATED
  PROCESSING
  ORDER_CREATED
  PENDING
  AUTHORIZED
  COMPLETED
  FAILED
  NEEDS_REVIEW
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id                String          @id @default(uuid())
  userId            String
  walletId          String
  provider          PaymentProvider @default(MOCK)
  providerOrderId   String?         @unique
  providerPaymentId String?         @unique
  amount            Decimal         @db.Decimal(18, 2)
  amountInPaise     Int
  currency          String          @db.VarChar(3)
  status            PaymentStatus   @default(CREATED)
  description       String?
  idempotencyKey    String          @unique
  failureReason     String?
  metadata          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  authorizedAt      DateTime?
  completedAt       DateTime?
  failedAt          DateTime?

  processingStartedAt DateTime?
  lastRecoveryAt      DateTime?
  recoveryAttempts    Int       @default(0)

  @@index([userId, createdAt])
  @@index([walletId, createdAt])
  @@index([status, createdAt])
  @@index([provider, providerOrderId])
  @@index([provider, status, createdAt])
  @@index([status, processingStartedAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actorEmail  String?
  action      String
  targetType  String
  targetId    String?
  description String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String?
  email     String?
  type      String
  title     String
  message   String
  channel   String    @default("IN_APP")
  status    String    @default("CREATED")
  isRead    Boolean   @default(false)
  metadata  Json?
  createdAt DateTime  @default(now())
  readAt    DateTime?
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([email])
  @@index([type])
  @@index([status])
  @@index([isRead])
  @@index([createdAt])
}

enum RewardType {
  SCRATCH_CARD
  REWARDED_AD
}

enum RewardStatus {
  AVAILABLE
  CLAIMED
  EXPIRED
  CANCELLED
}

model RewardCampaign {
  id               String     @id @default(uuid())
  name             String
  description      String?
  rewardType       RewardType @default(SCRATCH_CARD)
  minPaymentAmount Decimal?   @db.Decimal(18, 2)
  minRewardAmount  Decimal    @default(1) @db.Decimal(18, 2)
  maxRewardAmount  Decimal    @default(20) @db.Decimal(18, 2)
  active           Boolean    @default(true)
  startsAt         DateTime?
  endsAt           DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  rewards Reward[]

  @@index([active])
  @@index([startsAt, endsAt])
}

model Reward {
  id         String       @id @default(uuid())
  userId     String
  walletId   String
  paymentId  String?      @unique
  campaignId String?
  rewardType RewardType   @default(SCRATCH_CARD)
  amount     Decimal      @db.Decimal(18, 2)
  currency   String       @default("INR") @db.VarChar(3)
  status     RewardStatus @default(AVAILABLE)
  claimedAt  DateTime?
  expiresAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  campaign RewardCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([walletId])
  @@index([status])
  @@index([campaignId])
  @@index([expiresAt])
}

enum OfferStatus {
  DRAFT
  ACTIVE
  INACTIVE
  EXPIRED
}

enum OfferClaimStatus {
  CLAIMED
  REDEEMED
  EXPIRED
  CANCELLED
}

model Offer {
  id                 String       @id @default(uuid())
  title              String
  description        String
  merchant           String
  category           String
  currency           String       @db.VarChar(3)
  benefitDescription String
  status             OfferStatus  @default(DRAFT)
  startsAt           DateTime
  expiresAt          DateTime
  eligibilityRules   Json?
  usageLimit         Int?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  claims             OfferClaim[]

  @@index([status, startsAt, expiresAt])
  @@index([category])
}

model OfferClaim {
  id         String           @id @default(uuid())
  offerId    String
  userId     String
  status     OfferClaimStatus @default(CLAIMED)
  claimedAt  DateTime         @default(now())
  redeemedAt DateTime?
  expiresAt  DateTime
  offer      Offer            @relation(fields: [offerId], references: [id], onDelete: Restrict)
  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([offerId, userId])
  @@index([userId, status])
  @@index([expiresAt])
}

model Contact {
  id              String   @id @default(uuid())
  ownerUserId     String
  recipientUserId String
  nickname        String?
  favourite       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  owner           User     @relation("ContactOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  recipient       User     @relation("ContactRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)

  @@unique([ownerUserId, recipientUserId])
  @@index([ownerUserId, favourite])
}

enum MoneyRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

model MoneyRequest {
  id                   String             @id @default(uuid())
  requesterUserId      String
  payerUserId          String
  walletId             String
  currency             String             @db.VarChar(3)
  amount               Decimal            @db.Decimal(18, 2)
  note                 String?
  status               MoneyRequestStatus @default(PENDING)
  expiresAt            DateTime
  settlementTransferId String?            @unique
  idempotencyKey       String             @unique
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  requester            User               @relation("MoneyRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  payer                User               @relation("MoneyPayer", fields: [payerUserId], references: [id], onDelete: Restrict)
  wallet               Wallet             @relation(fields: [walletId], references: [id], onDelete: Restrict)
  settlementTransfer   Transfer?          @relation("MoneyRequestSettlement", fields: [settlementTransferId], references: [id], onDelete: Restrict)

  @@index([requesterUserId, status, createdAt])
  @@index([payerUserId, status, createdAt])
  @@index([expiresAt, status])
}

enum BillSplitType {
  EQUAL
  EXACT
}

enum BillSplitStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELLED
  EXPIRED
}

enum SplitAllocationStatus {
  PENDING
  PAID
  DECLINED
  CANCELLED
  EXPIRED
}

model BillSplit {
  id             String            @id @default(uuid())
  creatorUserId  String
  walletId       String
  currency       String            @db.VarChar(3)
  totalAmount    Decimal           @db.Decimal(18, 2)
  type           BillSplitType
  status         BillSplitStatus   @default(OPEN)
  note           String?
  dueAt          DateTime
  idempotencyKey String            @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  creator        User              @relation("SplitCreator", fields: [creatorUserId], references: [id], onDelete: Restrict)
  wallet         Wallet            @relation(fields: [walletId], references: [id], onDelete: Restrict)
  allocations    SplitAllocation[]

  @@index([creatorUserId, status, createdAt])
  @@index([dueAt, status])
}

model SplitAllocation {
  id                   String                @id @default(uuid())
  splitId              String
  participantUserId    String
  amount               Decimal               @db.Decimal(18, 2)
  status               SplitAllocationStatus @default(PENDING)
  settlementTransferId String?               @unique
  paidAt               DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  split                BillSplit             @relation(fields: [splitId], references: [id], onDelete: Cascade)
  participant          User                  @relation(fields: [participantUserId], references: [id], onDelete: Restrict)
  settlementTransfer   Transfer?             @relation("SplitAllocationSettlement", fields: [settlementTransferId], references: [id], onDelete: Restrict)

  @@unique([splitId, participantUserId])
  @@index([participantUserId, status])
}

enum ProviderAttemptStatus {
  PROVIDER_NOT_CONFIGURED
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

model RechargeAttempt {
  id             String                @id @default(uuid())
  userId         String
  operator       String
  mobileNumber   String
  planId         String?
  amount         Decimal               @db.Decimal(18, 2)
  currency       String                @db.VarChar(3)
  status         ProviderAttemptStatus @default(PROVIDER_NOT_CONFIGURED)
  providerRef    String?
  idempotencyKey String                @unique
  failureCode    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  user           User                  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status])
}

model BillPaymentAttempt {
  id             String                @id @default(uuid())
  userId         String
  category       String
  billerId       String?
  customerRef    String
  amount         Decimal               @db.Decimal(18, 2)
  currency       String                @db.VarChar(3)
  status         ProviderAttemptStatus @default(PROVIDER_NOT_CONFIGURED)
  providerRef    String?
  idempotencyKey String                @unique
  failureCode    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  user           User                  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status])
}

model SavedBiller {
  id          String   @id @default(uuid())
  userId      String
  billerId    String   @db.VarChar(120)
  category    String   @db.VarChar(40)
  customerRef String   @db.VarChar(160)
  nickname    String?  @db.VarChar(80)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, billerId, customerRef, category])
  @@index([userId, updatedAt])
}
model BillReminder {
  id            String   @id @default(uuid())
  userId        String
  savedBillerId String
  remindAt      DateTime
  note          String?  @db.VarChar(160)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, savedBillerId, remindAt])
  @@index([userId, remindAt])
  @@index([savedBillerId])
}
enum MandateStatus {
  PENDING
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
  FAILED
}

enum MandateFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

model Mandate {
  id                String           @id @default(uuid())
  userId            String
  merchant          String
  amount            Decimal?         @db.Decimal(18, 2)
  maxAmount         Decimal          @db.Decimal(18, 2)
  currency          String           @db.VarChar(3)
  frequency         MandateFrequency
  startAt           DateTime
  endAt             DateTime?
  status            MandateStatus    @default(PENDING)
  providerMandateId String?          @unique
  consentAt         DateTime
  idempotencyKey    String           @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  user              User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([status, startAt])
}

enum SupportCaseStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
  CLOSED
}

enum SupportCasePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model SupportCase {
  id            String              @id @default(uuid())
  userId        String
  transactionId String?
  category      String
  description   String
  status        SupportCaseStatus   @default(OPEN)
  priority      SupportCasePriority @default(NORMAL)
  resolution    String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  closedAt      DateTime?
  user          User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  transaction   Transfer?           @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  events        SupportCaseEvent[]

  @@index([userId, status, createdAt])
  @@index([status, priority, createdAt])
  @@index([transactionId])
}

model SupportCaseEvent {
  id          String             @id @default(uuid())
  caseId      String
  actorUserId String
  fromStatus  SupportCaseStatus?
  toStatus    SupportCaseStatus
  note        String?
  createdAt   DateTime           @default(now())
  supportCase SupportCase        @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@index([actorUserId])
}

enum NotificationDeadLetterStatus {
  PENDING
  REPLAYING
  REPLAYED
  REPLAY_FAILED
}

model NotificationDeadLetter {
  id              String                       @id @default(uuid())
  eventId         String?
  messageKey      String                       @unique
  eventType       String
  sourceQueue     String
  deadLetterQueue String
  payload         Json
  headers         Json?
  reason          String
  retryCount      Int                          @default(0)
  status          NotificationDeadLetterStatus @default(PENDING)
  replayCount     Int                          @default(0)
  replayedAt      DateTime?
  replayedBy      String?
  lastReplayError String?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  @@index([status, createdAt])
  @@index([eventId])
  @@index([eventType])
  @@index([deadLetterQueue, status])
}

model ProviderWebhookEvent {
  id              String   @id @default(uuid())
  provider        String
  providerEventId String
  eventType       String
  providerOrderId   String?
  providerPaymentId String?
  payloadHash     String
  status          String   @default("RECEIVED")
  attempts        Int      @default(0)
  lastError       String?
  processedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([provider, providerEventId])
  @@index([provider, status])
  @@index([eventType])
  @@index([provider, providerOrderId])
  @@index([providerPaymentId])
  @@index([createdAt])
}
