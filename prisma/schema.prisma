generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  phone        String?    @unique
  vpa          String?    @unique
  firstName    String
  lastName     String?
  passwordHash String?
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  wallets                Wallet[]
  refreshTokens          RefreshToken[]
  notificationPreference NotificationPreference?
  contactsOwned          Contact[]               @relation("ContactOwner")
  contactsReceived       Contact[]               @relation("ContactRecipient")
  offerClaims            OfferClaim[]
  moneyRequestsCreated   MoneyRequest[]          @relation("MoneyRequester")
  moneyRequestsToPay     MoneyRequest[]          @relation("MoneyPayer")
  billSplitsCreated      BillSplit[]             @relation("SplitCreator")
  splitAllocations       SplitAllocation[]
  mandates               Mandate[]
  supportCases           SupportCase[]
  rechargeAttempts       RechargeAttempt[]
  billPaymentAttempts    BillPaymentAttempt[]
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  deviceName String?
  userAgent  String?
  ipAddress  String?
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([lastUsedAt])
}

model Wallet {
  id        String       @id @default(uuid())
  userId    String
  currency  String       @default("INR")
  balance   Decimal      @default(0) @db.Decimal(18, 2)
  version   Int          @default(0)
  status    WalletStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user              User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  ledgerAccount     LedgerAccount?
  outgoingTransfers Transfer[]     @relation("SourceWallet")
  incomingTransfers Transfer[]     @relation("DestinationWallet")
  deposits          Deposit[]
  withdrawals       Withdrawal[]
  moneyRequests     MoneyRequest[]
  billSplits        BillSplit[]

  @@unique([userId, currency])
  @@index([userId])
  @@index([status])
}

model LedgerAccount {
  id        String              @id @default(uuid())
  walletId  String?             @unique
  code      String              @unique
  name      String
  type      LedgerAccountType
  currency  String              @default("INR")
  status    LedgerAccountStatus @default(ACTIVE)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  wallet  Wallet?       @relation(fields: [walletId], references: [id], onDelete: Restrict)
  entries LedgerEntry[]

  @@index([type])
  @@index([currency])
  @@index([status])
}

model Transfer {
  id                  String         @id @default(uuid())
  idempotencyKey      String         @unique
  sourceWalletId      String
  destinationWalletId String
  amount              Decimal        @db.Decimal(18, 2)
  currency            String         @default("INR")
  status              TransferStatus @default(PENDING)
  description         String?
  failureReason       String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  completedAt         DateTime?

  sourceWallet              Wallet           @relation("SourceWallet", fields: [sourceWalletId], references: [id], onDelete: Restrict)
  destinationWallet         Wallet           @relation("DestinationWallet", fields: [destinationWalletId], references: [id], onDelete: Restrict)
  ledgerEntries             LedgerEntry[]
  moneyRequestSettlement    MoneyRequest?    @relation("MoneyRequestSettlement")
  splitAllocationSettlement SplitAllocation? @relation("SplitAllocationSettlement")
  supportCases              SupportCase[]

  @@index([sourceWalletId])
  @@index([destinationWalletId])
  @@index([status])
  @@index([createdAt])
}

model Deposit {
  id             String        @id @default(uuid())
  idempotencyKey String        @unique
  walletId       String
  amount         Decimal       @db.Decimal(18, 2)
  currency       String        @default("INR")
  reference      String
  status         DepositStatus @default(PENDING)
  failureReason  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  completedAt    DateTime?

  wallet        Wallet        @relation(fields: [walletId], references: [id], onDelete: Restrict)
  ledgerEntries LedgerEntry[]

  @@index([walletId])
  @@index([status])
  @@index([createdAt])
}

model Withdrawal {
  id             String           @id @default(uuid())
  idempotencyKey String           @unique
  walletId       String
  amount         Decimal          @db.Decimal(18, 2)
  currency       String           @default("INR")
  reference      String
  status         WithdrawalStatus @default(PENDING)
  failureReason  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  completedAt    DateTime?

  wallet        Wallet        @relation(fields: [walletId], references: [id], onDelete: Restrict)
  ledgerEntries LedgerEntry[]

  @@index([walletId])
  @@index([status])
  @@index([createdAt])
}

model LedgerEntry {
  id              String          @id @default(uuid())
  transferId      String?
  depositId       String?
  withdrawalId    String?
  ledgerAccountId String
  entryType       LedgerEntryType
  amount          Decimal         @db.Decimal(18, 2)
  currency        String          @default("INR")
  createdAt       DateTime        @default(now())

  transfer      Transfer?     @relation(fields: [transferId], references: [id], onDelete: Restrict)
  deposit       Deposit?      @relation(fields: [depositId], references: [id], onDelete: Restrict)
  withdrawal    Withdrawal?   @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)
  ledgerAccount LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  @@index([transferId])
  @@index([depositId])
  @@index([withdrawalId])
  @@index([ledgerAccountId, createdAt])
  @@index([entryType])
}

model OutboxEvent {
  id            String       @id @default(uuid())
  producer      String?
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  createdAt     DateTime     @default(now())
  publishedAt   DateTime?
  lastError     String?

  @@index([status, createdAt])
  @@index([producer, status, createdAt])
  @@index([aggregateType, aggregateId])
}

model NotificationLog {
  id                String             @id @default(uuid())
  eventId           String?            @unique
  eventType         String
  recipient         String
  subject           String
  status            NotificationStatus @default(PENDING)
  providerMessageId String?
  errorMessage      String?
  attempts          Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  sentAt            DateTime?

  @@index([status, createdAt])
  @@index([recipient])
  @@index([eventType])
}

model NotificationPreference {
  id                 String   @id @default(uuid())
  userId             String   @unique
  inAppEnabled       Boolean  @default(true)
  emailEnabled       Boolean  @default(true)
  transfersEnabled   Boolean  @default(true)
  depositsEnabled    Boolean  @default(true)
  withdrawalsEnabled Boolean  @default(true)
  paymentsEnabled    Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  PREVIEW
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  SUSPENDED
}

enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum LedgerAccountType {
  CUSTOMER
  SYSTEM
}

enum LedgerAccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum TransferStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
}

enum DepositStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum PaymentProvider {
  MOCK
  RAZORPAY
  STRIPE
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id                String          @id @default(uuid())
  userId            String
  walletId          String
  provider          PaymentProvider @default(MOCK)
  providerOrderId   String?         @unique
  providerPaymentId String?         @unique
  amount            Decimal         @db.Decimal(18, 2)
  amountInPaise     Int
  currency          String          @db.VarChar(3)
  status            PaymentStatus   @default(CREATED)
  description       String?
  idempotencyKey    String          @unique
  failureReason     String?
  metadata          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  authorizedAt      DateTime?
  completedAt       DateTime?
  failedAt          DateTime?

  @@index([userId, createdAt])
  @@index([walletId, createdAt])
  @@index([status, createdAt])
  @@index([provider, providerOrderId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actorEmail  String?
  action      String
  targetType  String
  targetId    String?
  description String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String?
  email     String?
  type      String
  title     String
  message   String
  channel   String    @default("IN_APP")
  status    String    @default("CREATED")
  isRead    Boolean   @default(false)
  metadata  Json?
  createdAt DateTime  @default(now())
  readAt    DateTime?
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([email])
  @@index([type])
  @@index([status])
  @@index([isRead])
  @@index([createdAt])
}

enum RewardType {
  CASHBACK
  SCRATCH_CARD
  POINTS
}

enum RewardStatus {
  AVAILABLE
  CLAIMED
  EXPIRED
  CANCELLED
}

model RewardCampaign {
  id               String     @id @default(uuid())
  name             String
  description      String?
  rewardType       RewardType @default(SCRATCH_CARD)
  minPaymentAmount Decimal?   @db.Decimal(18, 2)
  minRewardAmount  Decimal    @default(1) @db.Decimal(18, 2)
  maxRewardAmount  Decimal    @default(20) @db.Decimal(18, 2)
  active           Boolean    @default(true)
  startsAt         DateTime?
  endsAt           DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  rewards Reward[]

  @@index([active])
  @@index([startsAt, endsAt])
}

model Reward {
  id         String       @id @default(uuid())
  userId     String
  walletId   String
  paymentId  String?      @unique
  campaignId String?
  rewardType RewardType   @default(SCRATCH_CARD)
  amount     Decimal      @db.Decimal(18, 2)
  currency   String       @default("INR") @db.VarChar(3)
  status     RewardStatus @default(AVAILABLE)
  claimedAt  DateTime?
  expiresAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  campaign RewardCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([walletId])
  @@index([status])
  @@index([campaignId])
  @@index([expiresAt])
}

enum OfferStatus {
  DRAFT
  ACTIVE
  INACTIVE
  EXPIRED
}

enum OfferClaimStatus {
  CLAIMED
  REDEEMED
  EXPIRED
  CANCELLED
}

model Offer {
  id                 String       @id @default(uuid())
  title              String
  description        String
  merchant           String
  category           String
  currency           String       @db.VarChar(3)
  benefitDescription String
  status             OfferStatus  @default(DRAFT)
  startsAt           DateTime
  expiresAt          DateTime
  eligibilityRules   Json?
  usageLimit         Int?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  claims             OfferClaim[]

  @@index([status, startsAt, expiresAt])
  @@index([category])
}

model OfferClaim {
  id         String           @id @default(uuid())
  offerId    String
  userId     String
  status     OfferClaimStatus @default(CLAIMED)
  claimedAt  DateTime         @default(now())
  redeemedAt DateTime?
  expiresAt  DateTime
  offer      Offer            @relation(fields: [offerId], references: [id], onDelete: Restrict)
  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([offerId, userId])
  @@index([userId, status])
  @@index([expiresAt])
}

model Contact {
  id              String   @id @default(uuid())
  ownerUserId     String
  recipientUserId String
  nickname        String?
  favourite       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  owner           User     @relation("ContactOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  recipient       User     @relation("ContactRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)

  @@unique([ownerUserId, recipientUserId])
  @@index([ownerUserId, favourite])
}

enum MoneyRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

model MoneyRequest {
  id                   String             @id @default(uuid())
  requesterUserId      String
  payerUserId          String
  walletId             String
  currency             String             @db.VarChar(3)
  amount               Decimal            @db.Decimal(18, 2)
  note                 String?
  status               MoneyRequestStatus @default(PENDING)
  expiresAt            DateTime
  settlementTransferId String?            @unique
  idempotencyKey       String             @unique
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  requester            User               @relation("MoneyRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  payer                User               @relation("MoneyPayer", fields: [payerUserId], references: [id], onDelete: Restrict)
  wallet               Wallet             @relation(fields: [walletId], references: [id], onDelete: Restrict)
  settlementTransfer   Transfer?          @relation("MoneyRequestSettlement", fields: [settlementTransferId], references: [id], onDelete: Restrict)

  @@index([requesterUserId, status, createdAt])
  @@index([payerUserId, status, createdAt])
  @@index([expiresAt, status])
}

enum BillSplitType {
  EQUAL
  EXACT
}

enum BillSplitStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELLED
  EXPIRED
}

enum SplitAllocationStatus {
  PENDING
  PAID
  DECLINED
  CANCELLED
  EXPIRED
}

model BillSplit {
  id             String            @id @default(uuid())
  creatorUserId  String
  walletId       String
  currency       String            @db.VarChar(3)
  totalAmount    Decimal           @db.Decimal(18, 2)
  type           BillSplitType
  status         BillSplitStatus   @default(OPEN)
  note           String?
  dueAt          DateTime
  idempotencyKey String            @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  creator        User              @relation("SplitCreator", fields: [creatorUserId], references: [id], onDelete: Restrict)
  wallet         Wallet            @relation(fields: [walletId], references: [id], onDelete: Restrict)
  allocations    SplitAllocation[]

  @@index([creatorUserId, status, createdAt])
  @@index([dueAt, status])
}

model SplitAllocation {
  id                   String                @id @default(uuid())
  splitId              String
  participantUserId    String
  amount               Decimal               @db.Decimal(18, 2)
  status               SplitAllocationStatus @default(PENDING)
  settlementTransferId String?               @unique
  paidAt               DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  split                BillSplit             @relation(fields: [splitId], references: [id], onDelete: Cascade)
  participant          User                  @relation(fields: [participantUserId], references: [id], onDelete: Restrict)
  settlementTransfer   Transfer?             @relation("SplitAllocationSettlement", fields: [settlementTransferId], references: [id], onDelete: Restrict)

  @@unique([splitId, participantUserId])
  @@index([participantUserId, status])
}

enum ProviderAttemptStatus {
  PROVIDER_NOT_CONFIGURED
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

model RechargeAttempt {
  id             String                @id @default(uuid())
  userId         String
  operator       String
  mobileNumber   String
  planId         String?
  amount         Decimal               @db.Decimal(18, 2)
  currency       String                @db.VarChar(3)
  status         ProviderAttemptStatus @default(PROVIDER_NOT_CONFIGURED)
  providerRef    String?
  idempotencyKey String                @unique
  failureCode    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  user           User                  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status])
}

model BillPaymentAttempt {
  id             String                @id @default(uuid())
  userId         String
  category       String
  billerId       String?
  customerRef    String
  amount         Decimal               @db.Decimal(18, 2)
  currency       String                @db.VarChar(3)
  status         ProviderAttemptStatus @default(PROVIDER_NOT_CONFIGURED)
  providerRef    String?
  idempotencyKey String                @unique
  failureCode    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  user           User                  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status])
}

enum MandateStatus {
  PENDING
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
  FAILED
}

enum MandateFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

model Mandate {
  id                String           @id @default(uuid())
  userId            String
  merchant          String
  amount            Decimal?         @db.Decimal(18, 2)
  maxAmount         Decimal          @db.Decimal(18, 2)
  currency          String           @db.VarChar(3)
  frequency         MandateFrequency
  startAt           DateTime
  endAt             DateTime?
  status            MandateStatus    @default(PENDING)
  providerMandateId String?          @unique
  consentAt         DateTime
  idempotencyKey    String           @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  user              User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([status, startAt])
}

enum SupportCaseStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
  CLOSED
}

enum SupportCasePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model SupportCase {
  id            String              @id @default(uuid())
  userId        String
  transactionId String?
  category      String
  description   String
  status        SupportCaseStatus   @default(OPEN)
  priority      SupportCasePriority @default(NORMAL)
  resolution    String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  closedAt      DateTime?
  user          User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  transaction   Transfer?           @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  events        SupportCaseEvent[]

  @@index([userId, status, createdAt])
  @@index([status, priority, createdAt])
  @@index([transactionId])
}

model SupportCaseEvent {
  id          String             @id @default(uuid())
  caseId      String
  actorUserId String
  fromStatus  SupportCaseStatus?
  toStatus    SupportCaseStatus
  note        String?
  createdAt   DateTime           @default(now())
  supportCase SupportCase        @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@index([actorUserId])
}
