# RabbitMQ
RABBITMQ_URL=amqp://payflow:payflow_password@localhost:5672
RABBITMQ_QUEUE=wallet_events
RABBITMQ_PREFETCH_COUNT=10

# Keep true while testing without sending real emails
EMAIL_PREVIEW_MODE=true

# SMTP configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Payflow <no-reply@payflow.local>
# During development, redirect every email here
EMAIL_TEST_RECIPIENT=
