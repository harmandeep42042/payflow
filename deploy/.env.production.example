# Payflow production environment template
#
# NEVER commit real secrets into this file.
# Copy this template to the deployment host / secret manager
# and supply real production values there.
#
# NEXT_PUBLIC_API_GATEWAY_URL must be the real non-local HTTPS API URL.
# Production Web build remains blocked until that value exists.

ADMIN_DOMAIN=
API_DOMAIN=
AUTH_LOGIN_RATE_LIMIT=
AUTH_LOGIN_RATE_WINDOW_SECONDS=
CORS_ALLOWED_ORIGINS=
CUSTOMER_DOMAIN=
DATABASE_URL=
JWT_REFRESH_SECRET=
JWT_SECRET=
NEXT_PUBLIC_API_GATEWAY_URL=
PAYMENT_SETTLEMENT_INTERNAL_TOKEN=
POSTGRES_DB=
POSTGRES_PASSWORD=
POSTGRES_USER=
QR_SIGNING_SECRET=
QR_SIGNING_SECRET_CURRENT=
QR_SIGNING_SECRET_PREVIOUS=
RABBITMQ_PASSWORD=
RABBITMQ_QUEUE=
RABBITMQ_URL=
RABBITMQ_USER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
REDIS_URL=
RELEASE_TAG=
SMSGATEWAYHUB_API_KEY=
SMSGATEWAYHUB_ENTITY_ID=
SMSGATEWAYHUB_SENDER_ID=
SMSGATEWAYHUB_TEMPLATE_ID=

# Optional. Leave unset to hide the Explore APIs CTA.
# NEXT_PUBLIC_API_DOCS_URL=
