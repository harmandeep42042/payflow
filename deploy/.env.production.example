# ==========================================================
# Payflow deployment template
# Copy this to the server and fill actual values.
# DO NOT put real secrets in this tracked template.
# ==========================================================

# Public domains
CUSTOMER_DOMAIN=payflow.example.com
ADMIN_DOMAIN=admin.payflow.example.com
API_DOMAIN=api.payflow.example.com

# Browser-facing API URL
PUBLIC_API_GATEWAY_URL=https://api.payflow.example.com/api/v1

# Browser origins allowed by Gateway + Notification Service
CORS_ALLOWED_ORIGINS=https://payflow.example.com,https://admin.payflow.example.com

# PostgreSQL
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=payflow_db
DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@postgres:5432/payflow_db

# Redis
REDIS_URL=redis://redis:6379

# RabbitMQ
RABBITMQ_USER=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_QUEUE=wallet_events
RABBITMQ_URL=amqp://CHANGE_ME:CHANGE_ME@rabbitmq:5672

# Authentication
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME

# Login rate limiting
AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_RATE_WINDOW_SECONDS=60

# Payment provider
RAZORPAY_KEY_ID=CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME