FROM node:24-alpine

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3001
ENV HOSTNAME=0.0.0.0
ENV API_GATEWAY_INTERNAL_URL=http://api-gateway:4000/api/v1

RUN corepack enable && corepack prepare pnpm@11.18.0 --activate

COPY docker/admin-runtime-package.json ./package.json
COPY docker/admin-runtime-pnpm-workspace.yaml ./pnpm-workspace.yaml

RUN pnpm install --prod --no-frozen-lockfile

COPY apps/admin-web/.next/standalone/apps/admin-web ./apps/admin-web
COPY apps/admin-web/.next/static ./apps/admin-web/.next/static
COPY apps/admin-web/public ./apps/admin-web/public

EXPOSE 3001

CMD ["node", "apps/admin-web/server.js"]
