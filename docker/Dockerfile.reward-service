FROM node:24-alpine

WORKDIR /app

ENV NODE_ENV=production

RUN corepack enable && corepack prepare pnpm@11.18.0 --activate

COPY dist/apps/reward-service/package.json ./package.json
COPY dist/apps/reward-service/pnpm-lock.yaml ./pnpm-lock.yaml

RUN --mount=type=cache,id=payflow-pnpm-store,target=/root/.local/share/pnpm/store/v11 pnpm config set fetch-retries 5 \
    && pnpm config set fetch-retry-mintimeout 20000 \
    && pnpm config set fetch-retry-maxtimeout 120000 \
    && pnpm config set fetch-timeout 600000 \
    && pnpm config set network-concurrency 4 \
    && pnpm install --prod --frozen-lockfile --ignore-scripts

COPY dist/apps/reward-service/main.js ./main.js
COPY dist/apps/reward-service/main.js.map ./main.js.map

EXPOSE 4007

USER node

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD node -e "const http=require('http');const r=http.get({host:'127.0.0.1',port:4007,path:'/api/v1/rewards/health',timeout:4000},res=>{res.resume();process.exit(res.statusCode>=200&&res.statusCode<400?0:1)});r.on('error',()=>process.exit(1));r.on('timeout',()=>{r.destroy();process.exit(1)})"

CMD ["node", "main.js"]
